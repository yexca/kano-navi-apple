    "openOnPlatform": {
      "comment": "Button that opens a page on a platform. %@ is the platform name, such as YouTube.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open on %@"
