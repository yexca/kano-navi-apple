    "spotlightLiveOn": {
      "comment": "Heading of an unannounced live broadcast. %@ is the platform name, such as Bilibili.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live now on %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で配信中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在 %@ 直播"
          }
        }
      }
    },
    "spotlightNext": {
      "comment": "Heading of the ticket for the next stream or entry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next Up"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の予定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将开始"
          }
        }
      }
    },
    "spotlightNoneMessage": {
      "comment": "Explains when the empty ticket fills in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New streams and events appear here once they’re announced."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信やイベントが告知されると、ここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直播和活动公布后会显示在这里。"
          }
        }
      }
    },
    "spotlightNoneTitle": {
      "comment": "Shown in the ticket when nothing is scheduled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing Scheduled"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定はありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无安排"
          }
        }
      }
    },
    "startedAt": {
      "comment": "When a live stream started. %@ is a time in Japan, such as Nov 10, 21:00 JST.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Started %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に開始"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 开始"
          }
        }
      }
    },
    "startsIn": {
      "comment": "Label above the countdown to the next start.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts in"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始まで"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离开始"
          }
        }
      }
    },
    "statusFailedTitle": {
      "comment": "Title shown above the last data when a refresh failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t Refresh"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新できませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法刷新"
          }
        }
      }
    },
    "statusIncompatibleMessage": {
      "comment": "Explains that the app needs an update to read the service's new data; the last data stays on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Kano Navi service has changed. Update the app to see new data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鹿乃ナビのサービスが変更されました。新しいデータを表示するにはアプリをアップデートしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鹿乃 Navi 服务已变更。请更新应用以查看新数据。"
          }
        }
      }
    },
    "statusIncompatibleTitle": {
      "comment": "Title shown when the service sends data this app version cannot read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Needed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要更新"
          }
        }
      }
    },
    "statusOffline": {
      "comment": "Shown when a refresh failed because the device is offline.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You appear to be offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインのようです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你似乎处于离线状态。"
          }
        }
      }
    },
    "statusServerError": {
      "comment": "Shown when the service answered a refresh with an HTTP error. %lld is the HTTP status code, such as 503.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service responded with error %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスがエラー %lld を返しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回了错误 %lld。"
          }
        }
      }
    },
    "statusShowingLast": {
      "comment": "Footnote of a failed refresh: when the data on screen was received. %@ is a date and time in Japan with JST, such as “Tue, Nov 10 11:20 JST”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing data received %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に受信したデータを表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示 %@ 收到的数据。"
          }
        }
      }
    },
    "statusShowingSaved": {
      "comment": "Footnote of a failed refresh when the data on screen is the copy saved on this device. %@ is when it was received, in Japan time with JST, such as “Tue, Nov 10 11:20 JST”.",
      "extractionState": "manual",
      "localizations": {
