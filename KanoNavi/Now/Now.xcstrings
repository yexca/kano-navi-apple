    "profilePostCount %lld %lld": {
      "comment": "VoiceOver label and tooltip of the profile card's post count, which opens Posts. The first %lld is the number of posts, the second the days they cover.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@ in %#@days@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg post"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg posts"
                    }
                  }
                }
              }
            },
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg day"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg days"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 日間のポスト %1$lld 件"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 天内动态 %1$lld 条"
          }
        }
      }
    },
    "profileTagline": {
      "comment": "Tagline above the name on the profile card. Japanese copy, the same in every language.",
