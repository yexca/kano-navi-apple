        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 打开"
          }
        }
      }
    },
    "openSite": {
      "comment": "Button that opens a page on another site. %@ is the site's host name, such as shop.example.com.",
