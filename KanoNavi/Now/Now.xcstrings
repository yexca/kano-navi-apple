{
  "sourceLanguage": "en",
  "strings": {
    "approximately": {
      "comment": "An estimated time. %@ is the time labelled with JST, such as “21:00 JST” or “Tue, Nov 10 21:00 JST”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 頃"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %@"
          }
        }
      }
    },
    "comingUpEmpty": {
      "comment": "Shown in Coming Up when nothing is scheduled today or in the 13 days after it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing scheduled in the next two weeks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後2週間の予定はありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来两周没有安排"
          }
        }
      }
    },
    "comingUpHeader": {
      "comment": "Header of the section listing the next entries of the next two weeks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coming Up"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後の予定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将到来"
          }
        }
      }
    },
    "comingUpLoadFailed": {
      "comment": "Notice in Coming Up when the schedule could not be loaded and nothing is saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The schedule couldn’t be loaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载日程。"
          }
        }
      }
    },
    "comingUpSaved %@": {
      "comment": "Notice in Coming Up when the service could not be read and the entries shown are the copy saved on this device. %@ is when that copy was read from the service, in Japan time with JST, such as “Tue, Nov 10 11:20 JST”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t update the schedule. Showing the copy from %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を更新できませんでした。%@ 時点の内容を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新日程。正在显示截至 %@ 的内容。"
          }
        }
      }
    },
    "comingUpToday": {
      "comment": "Day header in Coming Up for entries on today's date in Japan.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天"
          }
        }
      }
    },
    "comingUpTomorrow": {
      "comment": "Day header in Coming Up for entries on tomorrow's date in Japan.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomorrow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天"
          }
        }
      }
    },
    "comingUpUpdateFailed": {
      "comment": "Notice in Coming Up when a refresh failed while older entries stay on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t update the schedule. Showing the last loaded data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を更新できませんでした。最後に読み込んだ内容を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新日程。正在显示上次加载的内容。"
          }
        }
      }
    },
    "freshnessChecked": {
      "comment": "Label of when this device last received the dashboard.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked by this app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリの確認"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用检查"
          }
        }
      }
    },
    "freshnessDetailHint": {
      "comment": "Accessibility hint of the freshness line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows when each source was last read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ソースを最後に読み込んだ時刻を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示各来源最近一次读取的时间。"
          }
        }
      }
    },
    "freshnessFailed": {
      "comment": "Freshness summary when the last collection failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last collection failed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の収集に失敗しました"
