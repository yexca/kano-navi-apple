    "savedCopy": {
      "comment": "Notice that the data on screen is the copy saved on this device and has not been refreshed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing data saved on this device."
          }
