        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示本机保存的数据。"
          }
        }
      }
    },
    "savedCopyFrom": {
      "comment": "Notice that the data on screen is the copy saved on this device and has not been refreshed. %@ is when it was received, in Japan time with JST, such as “Tue, Nov 10 11:20 JST”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing data saved on this device from %@."
