{
  "sourceLanguage": "en",
  "strings": {
    "approximately": {
      "comment": "An estimated time. %@ is the time labelled with JST, such as “21:00 JST” or “Tue, Nov 10 21:00 JST”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 頃"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %@"
          }
        }
      }
    },
    "freshnessChecked": {
      "comment": "Label of when this device last received the dashboard.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked by this app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリの確認"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用检查"
          }
        }
      }
    },
    "freshnessFooter": {
      "comment": "Explains the source times in the freshness section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times are each source’s last successful read by the Kano Navi service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ソースを鹿乃ナビのサービスが最後に読み込めた時刻です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各来源最近一次被鹿乃 Navi 服务成功读取的时间。"
          }
        }
      }
    },
    "freshnessHeader": {
      "comment": "Header of the section showing how current the data is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Freshness"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データの更新状況"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据更新情况"
          }
        }
      }
    },
    "freshnessLastRun": {
      "comment": "Label of the last collection run's result.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last collection"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終収集"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近采集"
          }
        }
      }
    },
    "freshnessNotReadForADay": {
      "comment": "Marks a source not read for more than a day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not read for a day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日以上未読込"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过一天未读取"
          }
        }
      }
    },
    "freshnessOutOfDate": {
      "comment": "Marks a collection run older than a day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Out of date"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いデータ"
          }
