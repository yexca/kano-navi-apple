{
  "sourceLanguage": "en",
  "strings": {
    "imageFailed": {
      "comment": "VoiceOver value of an archive image that could not be fetched; a Try Again button is shown in its place.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load image"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を読み込めませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载图片"
          }
        }
      }
    },
    "imageRetry": {
      "comment": "Button shown in place of an archive image that could not be fetched; fetches it again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "imageUnavailable": {
      "comment": "Shown in place of an archive image the server does not have or that cannot be read. Also the VoiceOver value of that image.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image unavailable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を表示できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片无法显示"
          }
        }
      }
    },
    "viewerClose": {
      "comment": "Button that closes the full-screen image viewer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "viewerPosition": {
      "comment": "Counter in the full-screen image viewer. %1$lld is the position of the image shown, %2$lld the number of images.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        }
      }
    },
    "viewerPositionSpoken": {
      "comment": "VoiceOver reading of the full-screen image viewer’s counter. %1$lld is the position of the image shown, %2$lld the number of images.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image %1$lld of %2$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 枚中 %1$lld 枚目"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld 张，共 %2$lld 张"
          }
        }
      }
    }
  },
  "version": "1.0"
}
