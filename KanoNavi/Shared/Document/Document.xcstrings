{
  "sourceLanguage": "en",
  "strings": {
    "loadFailed": {
      "comment": "Notice when a page could not be loaded and nothing is on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load this page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページを読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载此页面。"
          }
        }
      }
    },
    "loading": {
      "comment": "Shown while a page of the app loads for the first time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载…"
          }
        }
      }
    },
    "reasonOffline": {
      "comment": "Reason a page could not be loaded: no connection to the service.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You appear to be offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインのようです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你似乎处于离线状态。"
          }
        }
      }
    },
    "reasonServerError": {
      "comment": "Reason a page could not be loaded. %lld is the HTTP status code the service answered with.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service responded with error %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスがエラー %lld を返しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回了错误 %lld。"
          }
        }
      }
    },
    "reasonUnreadable": {
      "comment": "Reason a page could not be loaded: the response could not be decoded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service sent data the app couldn’t read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが読み取れないデータが届きました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回了应用无法读取的数据。"
          }
        }
      }
    },
    "reasonUpdateNeeded": {
      "comment": "Reason a page could not be loaded: the service’s data needs a newer version of the app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Kano Navi service has changed. Update the app to see this page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鹿乃ナビのサービスが変更されました。このページを表示するにはアプリをアップデートしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鹿乃 Navi 服务已变更。请更新应用以查看此页面。"
          }
        }
      }
    },
    "retry": {
      "comment": "Button that reads a page of the app from the service again after a failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "savedCopy": {
      "comment": "Notice when the service could not be read and the page shown is the copy saved on this device. %@ is when that copy was read from the service, in Japan time with JST, such as “Tue, Nov 10 11:20 JST”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t update this page. Showing the copy from %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページを更新できませんでした。%@ 時点の内容を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新此页面。正在显示截至 %@ 的内容。"
          }
        }
      }
    },
    "unavailableTitle": {
      "comment": "Title of the screen shown when a page could not be loaded and nothing is saved on this device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t Load"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込めません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载"
          }
        }
      }
    },
    "updateFailed": {
      "comment": "Notice when reloading a page failed; what was loaded earlier stays on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t update this page. Showing what was loaded before."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページを更新できませんでした。前に読み込んだ内容を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新此页面。正在显示之前加载的内容。"
          }
        }
      }
    },
    "updateNeededTitle": {
      "comment": "Title of the screen shown when the service sends a page this version of the app cannot read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Needed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要更新"
          }
        }
      }
    }
  },
  "version": "1.0"
}
