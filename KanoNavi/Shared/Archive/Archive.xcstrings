{
  "sourceLanguage": "en",
  "strings": {
    "all": {
      "comment": "Archive filter choice that shows every item of the month.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "loadFailed": {
      "comment": "Notice when an archive month could not be loaded and nothing is on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load this month."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この月を読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载这个月的内容。"
          }
        }
      }
    },
    "loadMoreFailed": {
      "comment": "Shown at the end of an archive list when the next page could not be loaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load more."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続きを読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载更多。"
          }
        }
      }
    },
    "loading": {
      "comment": "Shown while an archive month loads for the first time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载…"
          }
        }
      }
    },
    "loadingMore": {
      "comment": "Shown at the end of an archive list while the next page loads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading more…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに読み込み中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载更多…"
          }
        }
      }
    },
    "month": {
      "comment": "Label of the menu that chooses the archive month.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Month"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月份"
          }
        }
      }
    },
    "monthWithCount": {
      "comment": "One choice of the archive month menu. %1$@ is the month and year, such as “November 2026”; %2$lld is the number of stored items in it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld）"
          }
        }
      }
    },
    "retry": {
      "comment": "Button that reads an archive month again after a failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "savedCopy": {
      "comment": "Notice when the service could not be read and the archive month shown is the copy saved on this device. %@ is when that copy was read from the service, in Japan time with JST, such as “Tue, Nov 10 11:20 JST”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t update this month. Showing the copy from %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この月を更新できませんでした。%@ 時点の内容を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新这个月的内容。正在显示截至 %@ 的内容。"
          }
        }
      }
    },
    "updateFailed": {
      "comment": "Notice when reloading an archive month failed; the items loaded earlier stay on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t update this month. Showing what was loaded before."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この月を更新できませんでした。前に読み込んだ内容を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新这个月的内容。正在显示之前加载的内容。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
