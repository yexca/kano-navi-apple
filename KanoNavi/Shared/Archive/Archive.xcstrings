{
  "sourceLanguage": "en",
  "strings": {
    "all": {
      "comment": "Archive filter choice that shows every item of the month.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "filterWithCount": {
      "comment": "One choice of a filter menu. %1$@ is the choice, such as “All” or an @handle; %2$lld is the number of items it shows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld）"
          }
        }
      }
    },
    "jumpToMonth": {
      "comment": "Name of the toolbar button and the title of the month grid that starts the Posts or Videos timeline at a chosen month.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump to Month"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月を選ぶ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择月份"
          }
        }
      }
    },
    "loadMoreFailed": {
      "comment": "Shown at the end of an archive list when the next page could not be loaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load more."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続きを読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载更多。"
          }
        }
      }
    },
    "loading": {
      "comment": "Shown while an archive month loads for the first time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载…"
          }
        }
      }
    },
    "loadingMore": {
      "comment": "Shown at the end of an archive list while the next page loads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading more…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに読み込み中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载更多…"
          }
        }
      }
    },
    "monthPostCount": {
      "comment": "VoiceOver value of a month in the Posts month grid. %lld is the number of posts in that month.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld post"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld posts"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件のポスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条动态"
          }
        }
      }
    },
    "monthVideoCount": {
      "comment": "VoiceOver value of a month in the Videos month grid. %lld is the number of videos in that month.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld video"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld videos"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 本の動画"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个视频"
          }
        }
      }
    },
    "newest": {
      "comment": "First choice of the month grid: the timeline from its newest item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Newest"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新"
          }
        }
      }
    },
    "retry": {
      "comment": "Button that reads an archive month again after a failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    }
  },
  "version": "1.0"
}
