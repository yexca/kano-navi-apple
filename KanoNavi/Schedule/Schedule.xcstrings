{
  "sourceLanguage": "en",
  "strings": {
    "autoDetected": {
      "comment": "The entry was read automatically from a post or a schedule image.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-detected"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動検出"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动识别"
          }
        }
      }
    },
    "autoDetectedFooter": {
      "comment": "Explains an auto-detected entry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read automatically from a post or a schedule image. Official announcements take precedence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿やスケジュール画像から自動で読み取った予定です。公式の告知が優先されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从帖子或日程图片中自动读取的日程。以官方公告为准。"
          }
        }
      }
    },
    "confirmed": {
      "comment": "The entry was checked by the site's maintainer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已确认"
          }
        }
      }
    },
    "confirmedFooter": {
      "comment": "Explains a confirmed entry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked by the Kano Navi maintainer. Official announcements take precedence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鹿乃ナビの管理者が確認した予定です。公式の告知が優先されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由鹿乃 Navi 维护者核对的日程。以官方公告为准。"
          }
        }
      }
    },
    "dayEntryCount": {
      "comment": "VoiceOver value of a calendar day: how many entries it has. %lld is the number.",
