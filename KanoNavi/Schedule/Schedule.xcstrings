    "staleNotice": {
      "comment": "Notice when the schedule shown is a saved copy rather than a fresh read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing a saved copy of the schedule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの予定を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示已保存的日程。"
          }
        }
      }
    },
    "staleNoticeSaved": {
      "comment": "Notice when the service could not be read and the schedule shown is the copy saved on this device. %@ is when that copy was read from the service, in Japan time with JST, such as “Tue, Nov 10 11:20 JST”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't update the schedule. Showing the copy from %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を更新できませんでした。%@ 時点の内容を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新日程。正在显示截至 %@ 的内容。"
          }
        }
      }
    },
