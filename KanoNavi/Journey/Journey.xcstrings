    "noteArtwork" : {
      "comment" : "Provenance note of promotional artwork.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Published promotional artwork. A corresponding model’s reveal date requires a production announcement or stream record."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開された宣伝ビジュアルやイラストです。対応するモデルの公開日は制作告知や配信記録に基づきます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这张图记录已公开的宣传视觉或插画；对应可动模型的公开时间需以制作公告或配信记录为准。"
          }
        }
      }
    },
    "noteCancelledRelease" : {
      "comment" : "Provenance note of the cover of a cancelled release.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every edition was cancelled before sale. The published artwork is kept, dated as the Works page records it rather than by the planned release."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての盤が発売前に中止されました。公開済みのジャケットを残し、日付は発売予定日ではなく作品ページの記録に従います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有版本都在发售前中止。保留已公开的封面，日期按作品页的记录，不是原定发售日。"
          }
        }
      }
    },
    "noteCover" : {
      "comment" : "Provenance note of a release cover.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The date belongs to the release or distribution of the work. Cover artwork and streaming models are recorded separately."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付は作品の発売・配信日です。ジャケットイラストと配信モデルは別々に記録しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日期为作品发行或开始配信日。唱片插画与直播模型分别记录。"
          }
        }
      }
    },
    "noteFrame" : {
      "comment" : "Provenance note of a stream frame.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The original stream link and frame timestamp are preserved. The third-party archive documents a historical official stream."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元配信リンクとフレームの時刻を記録。第三者アーカイブは過去の公式配信をたどるための出典です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留原直播链接与截帧时刻。第三方存档用于追溯已失效的历史官方配信。"
          }
        }
      }
    },
    "noteMahoroDebut" : {
      "comment" : "Provenance note of the character introduction image.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The character debuted on 2021-05-29. This introduction image was posted on 2021-05-30 in Japan time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャラクターの初配信は 2021-05-29。この紹介画像の元投稿は日本時間の 2021-05-30 です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角色首播为 2021-05-29；这张角色介绍图的原帖日期为日本时间 2021-05-30。"
          }
        }
      }
    },
    "noteModelAnnouncement" : {
      "comment" : "Provenance note of a model demonstration image.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The date belongs to the verified model demonstration announcement, rather than establishing its first appearance on stream."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付は確認済みのモデル紹介告知日であり、配信での初使用日を意味しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日期为已核对的模型展示公告日；不据此推定模型首次用于直播的时间。"
          }
        }
      }
    },
    "noteOutfitMerch" : {
      "comment" : "Provenance note of an outfit image taken from merchandise.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The date belongs to the depicted outfit’s reveal. This image is from commemorative merchandise; its own first publication date is unverified."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付は描かれた衣装の公開日。画像は記念グッズからのもので、商品画像の初公開日は未確認です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日期为图中衣装的公开日，图片来自纪念周边；商品图片首发日期未确认。"
          }
        }
      }
    },
    "noteRecap" : {
      "comment" : "Provenance note of an image attached to a stream thank-you post.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attached to the artist’s stream thank-you post on 2021-06-11. The outfit’s original reveal date remains unverified."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本人の 2021-06-11 の配信お礼投稿に添えられた画像。衣装の初公開日は未確認です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图片来自本人 2021-06-11 的配信感谢帖；记录回顾帖日期，衣装首发时间尚未确认。"
          }
        }
      }
    },
    "noteSiteCapture" : {
      "comment" : "Provenance note of an image captured from the agency website.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
