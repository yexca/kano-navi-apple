    "commentsNote": {
      "comment": "Line in the LINE BLOG info sheet about the archived comments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comments are what an archived copy of each page preserved, in their original Japanese; later ones are missing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コメントは保存ページに残っていたもので、それより後に書かれたものは含まれていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评论是各页面存档中保留下来的，保持日文原文；存档之后的评论没有收录。"
          }
        }
      }
    },
    "info": {
      "comment": "Title of the LINE BLOG info button and the sheet it opens: what the archive is and whose its contents are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About This Archive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアーカイブについて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于本存档"
          }
        }
      }
    },
    "introBody": {
      "comment": "First line of the LINE BLOG info sheet. LINE BLOG is the closed blogging service; Kano is the singer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kano wrote this blog on LINE BLOG, a service that has since closed. Its articles were recovered from web archive captures, with their pictures, videos and reader comments."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鹿乃さんが LINE BLOG で書いていたブログです。サービスはすでに終了しており、ウェブアーカイブに残っていた記事を、写真・動画・読者のコメントとともに復元しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是鹿乃在 LINE BLOG 上写的博客。该服务已经关闭，这里的文章连同图片、视频和读者评论，都是从网页存档中恢复的。"
          }
        }
      }
    },
    "linkInArticle": {
