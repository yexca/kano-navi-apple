    "rightsNotice": {
      "comment": "Rights notice of the LINE BLOG archive, at the foot of its info sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The articles, pictures, videos and comments in this archive belong to Kano and their respective rights holders. This is an unofficial fan archive, not affiliated with LINE or related organizations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアーカイブの記事・画像・動画・コメントの権利は、鹿乃さんと各権利者に帰属します。ファンによる非公式のアーカイブで、LINE および関係団体とは関係ありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本存档中的文章、图片、视频和评论，其权利归鹿乃及相应权利人所有。这是粉丝整理的非官方存档，与 LINE 及相关组织无关。"
          }
        }
      }
    },
    "sources": {
