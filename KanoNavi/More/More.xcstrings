{
  "sourceLanguage": "en",
  "strings": {
    "aboutData": {
      "comment": "Explains where the app's data comes from.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedules, videos and posts come from the Kano Navi service, which collects them from public sources. Each item links back to its original post."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定・動画・ポストは、公開情報を集める鹿乃ナビのサービスから届きます。各項目は元の投稿にリンクしています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日程、视频和动态来自鹿乃 Navi 服务，由其从公开来源收集。每一项都链接回原始发布。"
          }
        }
      }
    },
    "aboutLinksHeader": {
      "comment": "Header of the About links.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接"
          }
        }
      }
    },
    "aboutSourceCode": {
      "comment": "Link to the service's source code repository.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source Code"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースコード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源代码"
          }
        }
      }
    },
    "aboutUnofficial": {
      "comment": "States the app's independence. Kano Mahoro is the VTuber the app follows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kano Navi is an unofficial fan project. It is not affiliated with Kano Mahoro or her agency."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鹿乃ナビは非公式のファンプロジェクトです。鹿乃まほろさんおよび所属事務所とは一切関係ありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鹿乃 Navi 是非官方的粉丝项目，与鹿乃まほろ及其所属事务所无关。"
          }
        }
      }
    },
    "aboutVersion": {
      "comment": "Label of the app's version number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "aboutWebBoard": {
      "comment": "Link to the Kano Navi website.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kano Navi on the Web"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web 版鹿乃ナビ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鹿乃 Navi 网页版"
          }
        }
      }
    },
    "moreAbout": {
      "comment": "Row and screen title for information about the app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリについて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "moreComingLater": {
      "comment": "Shown beside a More row whose screen is not available yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coming later"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敬请期待"
          }
        }
      }
    },
    "moreComingLaterHeader": {
      "comment": "Header of the More rows whose screens are not available yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coming Later"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後追加予定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将推出"
          }
        }
      }
    },
    "moreJourney": {
      "comment": "Row for the Journey screen (a timeline of milestones), not available yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Journey"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あゆみ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历程"
          }
        }
      }
    },
    "moreLineBlog": {
      "comment": "Row for the archive of LINE BLOG posts, not available yet. LINE BLOG is a product name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LINE BLOG Archive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LINE BLOG アーカイブ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LINE BLOG 存档"
          }
        }
      }
    },
    "moreSettings": {
      "comment": "Row and screen title for the app's settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "moreWorks": {
      "comment": "Row for the Works screen (videos and releases), not available yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作品"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作品"
          }
        }
      }
    },
    "settingsAppLanguageButton": {
      "comment": "Button that opens this app's page in the Settings app, where its language is set.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change in Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で変更"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中更改"
          }
        }
      }
    },
    "settingsAppLanguageFooter": {
      "comment": "Explains where the interface language is set.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons and labels follow the language chosen for Kano Navi in the Settings app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンやラベルは、設定アプリで鹿乃ナビに選んだ言語で表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按钮和标签使用在“设置”应用中为鹿乃 Navi 选择的语言。"
          }
        }
      }
    },
    "settingsAppLanguageHeader": {
      "comment": "Header of the interface language section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Language"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの言語"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用语言"
          }
        }
      }
    },
    "settingsContentLanguageFooter": {
      "comment": "Explains what the content language changes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chooses the language of post text and of video and event titles. A translation is marked and can be switched to the original."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポスト本文や動画・予定のタイトルの言語を選びます。翻訳にはマークが付き、原文に切り替えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择动态正文以及视频和日程标题的语言。译文带有标记，并可切换为原文。"
          }
        }
      }
    },
    "settingsContentLanguageHeader": {
      "comment": "Header and label of the content language picker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content Language"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツの言語"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容语言"
          }
        }
      }
    },
    "settingsSameAsApp": {
      "comment": "Content language choice that follows the app's interface language.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same as App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリと同じ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与应用相同"
          }
        }
      }
    }
  },
  "version": "1.0"
}
