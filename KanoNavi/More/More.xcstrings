{
  "sourceLanguage": "en",
  "strings": {
    "aboutBuiltWithModels": {
      "comment": "Footnote naming the AI models the app was developed with. %@ is the list of model names, which are not translated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built with %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で開発"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 开发"
          }
        }
      }
    },
    "aboutSourceCode": {
      "comment": "Link to the service's source code repository.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source Code"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースコード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源代码"
          }
        }
      }
    },
    "aboutUnofficial": {
      "comment": "States the app's independence. Kano Mahoro is the VTuber the app follows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unofficial fan project. Not affiliated with Kano Mahoro or her agency."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公式のファンプロジェクトです。鹿乃まほろさん・所属事務所とは関係ありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非官方粉丝项目，与鹿乃まほろ及其所属事务所无关。"
          }
        }
      }
    },
    "aboutVersionNumber": {
      "comment": "The app's version under its name in About. %@ is the version and build, such as “0.1.0 (1)”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
