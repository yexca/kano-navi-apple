{
  "sourceLanguage": "en",
  "strings": {
    "aboutAppSourceCode": {
      "comment": "Link to the app's source code repository.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Source Code"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのソースコード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用源代码"
          }
        }
      }
    },
    "aboutBuiltWithModels": {
      "comment": "Footnote naming the AI models the app was developed with. %@ is the list of model names, which are not translated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built with %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で開発"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 开发"
          }
        }
      }
    },
    "aboutLicense": {
      "comment": "Row linking the app's license; its value is the license name, AGPL-3.0.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "License"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライセンス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "许可证"
          }
        }
      }
    },
    "aboutServiceSourceCode": {
      "comment": "Link to the source code repository of the service the app reads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service Source Code"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスのソースコード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务源代码"
          }
        }
      }
    },
    "aboutUnofficial": {
      "comment": "States the app's independence. Kano Mahoro is the VTuber the app follows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unofficial fan project. Not affiliated with Kano Mahoro or her agency."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公式のファンプロジェクトです。鹿乃まほろさん・所属事務所とは関係ありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非官方粉丝项目，与鹿乃まほろ及其所属事务所无关。"
          }
        }
      }
    },
    "aboutVersionNumber": {
      "comment": "The app's version under its name in About. %@ is the version and build, such as “0.1.0 (1)”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@"
          }
        }
      }
    },
    "aboutWebBoard": {
      "comment": "Link to the Kano Navi website.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kano Navi on the Web"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web 版鹿乃ナビ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鹿乃 Navi 网页版"
          }
        }
      }
    },
    "aboutWindowTitle": {
      "comment": "App menu item and window title for the Mac's About window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Kano Navi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鹿乃ナビについて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于鹿乃 Navi"
          }
        }
      }
    },
    "moreAbout": {
      "comment": "Row and screen title for information about the app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリについて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "moreJourney": {
      "comment": "Row and screen title for the Journey screen (a timeline of milestones).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Journey"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あゆみ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历程"
          }
        }
      }
    },
    "moreLineBlog": {
      "comment": "Row and screen title for the archive of LINE BLOG posts. LINE BLOG is a product name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LINE BLOG Archive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LINE BLOG アーカイブ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LINE BLOG 存档"
          }
        }
      }
    },
    "moreSettings": {
      "comment": "Row and screen title for the app's settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "moreWorks": {
      "comment": "Row and screen title for the Works screen (the discography).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作品"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作品"
          }
        }
      }
    },
    "serverAdd": {
      "comment": "Button and sheet title for adding a server by name and address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Server"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加服务器"
          }
        }
      }
    },
    "serverAddress": {
      "comment": "Label of the server address field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
    "serverAddressFooter": {
      "comment": "Footer under the server address field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The HTTPS address of a Kano Navi service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kano Navi サービスの HTTPS アドレス。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kano Navi 服务的 HTTPS 地址。"
          }
        }
      }
    },
    "serverChecking": {
      "comment": "Accessibility label of the spinner shown while a new server is checked.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking server"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーを確認中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查服务器"
          }
        }
      }
    },
    "serverFooter": {
      "comment": "Footer under the server list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app reads the board from the selected server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだサーバーからボードを読み込みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用从所选服务器读取看板内容。"
          }
        }
      }
    },
    "serverJapan": {
      "comment": "Name of the built-in Kano Navi server in Japan, the default.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Japan Server"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日本サーバー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日本服务器"
          }
        }
      }
    },
    "serverMainlandChina": {
      "comment": "Name of the built-in Kano Navi server in mainland China.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainland China Server"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中国大陸サーバー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中国大陆服务器"
          }
        }
      }
    },
    "serverName": {
      "comment": "Label of the server name field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "serverNamePrompt": {
      "comment": "Placeholder of the optional server name field, which shows no label on iPhone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name (Optional)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前（任意）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称（可选）"
          }
        }
      }
    },
    "serverProblemDuplicate": {
      "comment": "Error when the typed server is already in the list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server is already listed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは追加済みです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该服务器已在列表中。"
          }
        }
      }
    },
    "serverProblemIncompatible": {
      "comment": "Error when the typed server responded but is not a compatible Kano Navi service.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn’t a compatible Kano Navi service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応する Kano Navi サービスではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是兼容的 Kano Navi 服务。"
          }
        }
      }
    },
    "serverProblemInvalid": {
      "comment": "Error when the typed server address cannot be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address isn’t valid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスが正しくありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址无效。"
          }
        }
      }
    },
    "serverProblemNotHTTPS": {
      "comment": "Error when the typed server address does not use HTTPS.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an HTTPS address."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS のアドレスを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 HTTPS 地址。"
          }
        }
      }
    },
    "serverProblemUnreachable": {
      "comment": "Error when the typed server did not respond.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t reach this server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到该服务器。"
          }
        }
      }
    },
    "serverRemove": {
      "comment": "Context menu action removing a server the person added.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "settingsAppLanguage": {
      "comment": "Row that opens this app's page in the Settings app, where its interface language is set.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Language"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの言語"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用语言"
          }
        }
      }
    },
    "settingsAppLanguageHint": {
      "comment": "Accessibility hint of the App Language row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the Settings app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定アプリを開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“设置”应用。"
          }
        }
      }
    },
    "settingsContentLanguage": {
      "comment": "Label of the content language menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content Language"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツの言語"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容语言"
          }
        }
      }
    },
    "settingsGeneral": {
      "comment": "Pane of the Mac's Settings window holding the language settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
    },
    "settingsLanguageFooter": {
      "comment": "Footer under the language settings, telling the content and interface languages apart.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content Language sets post text and titles; App Language sets the interface."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツの言語は投稿や動画タイトルに、アプリの言語は画面表示に使われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容语言用于帖子和标题，应用语言用于界面。"
          }
        }
      }
    },
    "settingsNotificationsRow": {
      "comment": "Row in Settings opening Notification Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        }
      }
    },
    "settingsSameAsApp": {
      "comment": "Content language choice that follows the app's interface language.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same as App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリと同じ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与应用相同"
          }
        }
      }
    },
    "settingsServer": {
      "comment": "Settings row, screen title, and Mac Settings pane for choosing the Kano Navi service the app reads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器"
          }
        }
      }
