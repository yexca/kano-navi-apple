    "disclaimer": {
      "comment": "Footer of the Works info sheet: the app is unofficial and where the cover images come from.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unofficial fan project. Covers and works belong to their rights holders; images taken from a store or database page are marked as such."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公式のファンプロジェクトです。ジャケットと作品の権利は各権利者に帰属します。ショップやデータベースから取得した画像にはその旨を記しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非官方粉丝项目。封面与作品的权利属于各自的权利人；取自商店或数据库页面的图片均已注明。"
          }
        }
      }
    },
