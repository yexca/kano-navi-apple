{
  "sourceLanguage": "en",
  "strings": {
    "archiveEmpty": {
      "comment": "Shown when the video archive holds no month at all.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No videos are stored yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された動画はまだありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有已保存的视频。"
          }
        }
      }
    },
    "archiveMonthEmpty": {
      "comment": "Shown when the chosen month and type have no stored videos.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
