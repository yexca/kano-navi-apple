{
  "sourceLanguage": "en",
  "strings": {
    "filterEmpty": {
      "comment": "Shown when the Videos filter matches none of the timeline's videos.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No videos match."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "該当する動画はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有符合的视频。"
          }
        }
      }
    },
    "jumpToMonth": {
      "comment": "Name of the Videos toolbar menu that starts the timeline at a chosen month.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump to Month"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月を選ぶ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择月份"
          }
        }
      }
    },
    "kind": {
      "comment": "Heading of the kind choices in the Videos filter menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kind"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種類"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "种类"
          }
        }
      }
    },
    "kindStreams": {
      "comment": "Videos filter choice: live streams, stream reservations and stream archives.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直播"
          }
        }
      }
    },
    "kindVideos": {
      "comment": "Videos filter choice: uploaded videos and premieres.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频"
          }
        }
      }
    },
    "newest": {
      "comment": "Choice of the Videos month menu that starts the timeline at the newest video.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Newest"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新"
          }
        }
      }
    },
    "onAir": {
      "comment": "Header of the section at the top of the video timeline that lists the videos live or past their start now.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Air"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在直播"
          }
        }
      }
    },
    "platform": {
      "comment": "Heading of the platform choices in the Videos filter menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Platform"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラットフォーム"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平台"
          }
        }
      }
    },
    "shorts": {
      "comment": "Videos filter choice: YouTube Shorts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shorts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shorts"
          }
        }
      }
    },
    "timelineEmpty": {
      "comment": "Shown when the video timeline lists no video at all.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No videos are stored yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された動画はまだありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有已保存的视频。"
          }
        }
      }
    },
    "timelineLoadFailed": {
      "comment": "Notice when the video timeline could not be loaded and nothing is on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load videos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载视频。"
          }
        }
      }
    },
    "timelineSavedCopy": {
      "comment": "Notice when the service could not be read and the video timeline is the copy saved on this device. %@ is when that copy was read, in Japan time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t update videos. Showing the copy from %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を更新できませんでした。%@ 時点の内容を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新视频。正在显示截至 %@ 的内容。"
          }
        }
      }
    },
    "timelineUpdateFailed": {
      "comment": "Notice when reloading the video timeline failed; the videos loaded earlier stay on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t update videos. Showing what was loaded before."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を更新できませんでした。前に読み込んだ内容を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新视频。正在显示之前加载的内容。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
