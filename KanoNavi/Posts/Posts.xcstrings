{
  "sourceLanguage": "en",
  "strings": {
    "accountEmpty": {
      "comment": "Shown when the chosen account has no posts in the timeline.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No posts from this account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントのポストはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账号没有动态。"
          }
        }
      }
    },
    "accountFilter": {
      "comment": "Name of the account filter menu of the Posts timeline.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter by account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントで絞り込む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按账号筛选"
          }
        }
      }
    },
    "agencyPost": {
      "comment": "Chip on a post by a related account (the agency) that the site shows beside Kano's own posts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agency Post"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事務所のポスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事务所动态"
          }
        }
      }
    },
    "image": {
      "comment": "VoiceOver label of a post image that has no description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片"
          }
        }
      }
    },
    "moreImages": {
      "comment": "Shown over the last image drawn when a post has more. %lld is the number of images not drawn.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld"
          }
        }
      }
    },
    "openQuote": {
      "comment": "Button that opens the quoted post on X.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Quoted Post"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用元を開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开引用的帖子"
          }
        }
      }
    },
    "openQuoteBilibili": {
      "comment": "Button that opens the forwarded Bilibili dynamic.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Forwarded Post"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送元を開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开转发的动态"
          }
        }
      }
    },
    "quoteUnavailable": {
      "comment": "Shown in place of a quoted post that was deleted or withheld.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quoted post unavailable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用元のポストは表示できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引用的动态已无法查看"
          }
        }
      }
    },
    "sourceX": {
      "comment": "The platform name X: an X post's account when the post does not name its handle, and the button that opens a post on X.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "X"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "X"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "X"
          }
        }
      }
    },
    "timelineEmpty": {
      "comment": "Shown when the service stores no posts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No posts are stored yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたポストはまだありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未保存任何动态。"
          }
        }
      }
    },
    "timelineLoadFailed": {
      "comment": "Notice when the post timeline could not be loaded and nothing is on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load posts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポストを読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载动态。"
          }
        }
      }
    },
    "timelineSavedCopy": {
      "comment": "Notice when the service could not be read and the post timeline is the copy saved on this device. %@ is when that copy was read, in Japan time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t update posts. Showing the copy from %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポストを更新できませんでした。%@ 時点の内容を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新动态。正在显示截至 %@ 的内容。"
          }
        }
      }
    },
    "timelineUpdateFailed": {
      "comment": "Notice when the post timeline could not be read again; the posts loaded before stay on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t update posts. Showing what was loaded before."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポストを更新できませんでした。前に読み込んだ内容を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新动态。正在显示之前加载的内容。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
