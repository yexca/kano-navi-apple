{
  "sourceLanguage": "en",
  "strings": {
    "accountFilter": {
      "comment": "Name of the account filter menu on the Posts tab and in the post archive.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter by account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントで絞り込む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按账号筛选"
          }
        }
      }
    },
    "agencyPost": {
      "comment": "Chip on a post by a related account (the agency) that the site shows beside Kano's own posts.",
