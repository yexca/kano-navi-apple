          "stringUnit": {
            "state": "translated",
            "value": "简体中文"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "简体中文"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简体中文"
          }
        }
      }
    },
    "widgetLanguageType": {
      "comment": "The kind of value the content-language widget setting holds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content Language"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツの言語"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容语言"
          }
        }
      }
    },
    "widgetMoreCount": {
      "comment": "Entries on a day that did not fit. %lld is their number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld more"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほか%lld件"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另有%lld项"
          }
        }
      }
    },
    "widgetNoEntries": {
      "comment": "Shown for a day without entries in the week view.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No entries"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定なし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无安排"
          }
        }
      }
    },
    "widgetNothingScheduled": {
      "comment": "Shown when the next two weeks have no entries.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing scheduled in the next two weeks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後2週間の予定はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来两周没有安排。"
          }
        }
      }
    },
    "widgetStale": {
      "comment": "The widget could not reach the service and shows saved data of unknown age.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not updated"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未更新"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未更新"
          }
        }
      }
    },
    "widgetStaleAsOf": {
      "comment": "The widget could not reach the service. %@ is the Japan time the saved data was read, such as 10:32 JST.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As of %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 時点"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截至 %@"
          }
        }
      }
    },
    "widgetTimesInJST": {
      "comment": "Note in a widget header that every time shown is Japan time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times in JST"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日本時間"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日本时间"
          }
        }
      }
    },
    "widgetToday": {
      "comment": "Japan calendar day label for today.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天"
          }
        }
      }
    },
    "widgetTomorrow": {
      "comment": "Japan calendar day label for tomorrow.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomorrow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天"
          }
        }
      }
    },
    "widgetUnavailableMessage": {
      "comment": "Follows widgetUnavailableTitle; the widget retries on its own.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will try again soon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらくすると再試行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后将自动重试。"
          }
        }
      }
    },
    "widgetUnavailableTitle": {
      "comment": "The widget could not load the schedule and has nothing saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedule unavailable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を読み込めません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入日程"
          }
        }
      }
    },
    "widgetUpNext": {
      "comment": "Heading above the next scheduled entry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up Next"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の予定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一项"
          }
        }
      }
    },
    "widgetUpcomingDescription": {
      "comment": "Description of the upcoming-schedule widget in the widget gallery.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what Kano has coming up and when."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鹿乃ちゃんのこれからの予定と時間を確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看鹿乃接下来的安排和时间。"
          }
        }
      }
    },
    "widgetUpcomingName": {
      "comment": "Name of the upcoming-schedule widget in the widget gallery.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これからの予定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来的日程"
          }
        }
      }
    }
  },
  "version": "1.0"
}
