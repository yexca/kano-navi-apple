{
  "sourceLanguage": "en",
  "strings": {
    "widgetAllDay": {
      "comment": "Shown instead of a time for an entry with only a date.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全天"
          }
        }
      }
    },
    "widgetEndsAt": {
      "comment": "When a live stream ends. %@ is a Japan time, such as 23:00 JST.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 終了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 结束"
          }
        }
      }
    },
    "widgetInlineEntry": {
      "comment": "One-line Lock Screen widget. %1$@ is a time such as 21:00 JST or the word Live; %2$@ is the event title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "widgetIntentDescription": {
      "comment": "Explains the Upcoming widget's settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the language of event titles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定のタイトルの言語を選びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择日程标题的语言。"
          }
        }
      }
    },
    "widgetIntentLanguage": {
      "comment": "Name of the widget setting that picks the language of event titles.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content Language"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツの言語"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容语言"
          }
        }
      }
    },
    "widgetIntentTitle": {
      "comment": "Title of the Upcoming widget's settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
