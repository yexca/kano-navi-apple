          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与应用相同"
          }
        }
      }
    },
    "widgetLanguageSimplifiedChinese": {
      "comment": "Content-language choice, written in its own language.",
      "extractionState": "manual",
      "localizations": {
