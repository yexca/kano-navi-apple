            "value": "日本語"
          }
        }
      }
    },
    "widgetLanguageSameAsApp": {
      "comment": "Content-language choice: use the app's interface language.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
