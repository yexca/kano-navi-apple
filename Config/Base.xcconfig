// Build settings shared by every configuration.
//
// `//` starts a comment in an xcconfig file, so the scheme separator is written
// as `/$()/`, which expands to `//`.

// Origin of the Kano Navi service. The app reads it from Info.plist through
// `KanoNaviAPIBaseURL`; it must use HTTPS.
API_BASE_URL = https:/$()/kano.yexca.net

// An optional, git-ignored override for this machine, for example a local
// backend. See Tools/local-backend/README.md.
#include? "Local.xcconfig"
